{%- comment -%} Product grid fed by any collection (New Arrivals, Sale, …). {%- endcomment -%}
{%- assign coll = section.settings.collection -%}
{%- if coll == blank -%}{%- assign coll = collections.all -%}{%- endif -%}
{%- assign limit = section.settings.products_to_show -%}

<section class="sec wrap" {% if section.settings.tight_top %}style="padding-top:2vh"{% endif %}>
  <div class="sec-head rv">
    <div>
      {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2 class="h-lg" style="margin-top:12px">{{ section.settings.heading | default: coll.title }}</h2>
    </div>
    {%- if section.settings.link_label != blank -%}
      <a class="btn btn-sm" href="{{ coll.url }}"><span>{{ section.settings.link_label }}</span></a>
    {%- endif -%}
  </div>

  {%- if coll.products.size == 0 -%}
    <div class="empty"><span class="orn">✦</span><p>No products in this collection yet.</p>
      <a class="btn btn-sm" href="{{ routes.all_products_collection_url }}"><span>Shop everything</span></a></div>
  {%- else -%}
    <div class="pgrid{% if section.settings.wide %} wide{% endif %}">
      {%- for product in coll.products limit: limit -%}
        {% render 'product-card', product: product, index: forloop.index0, show_quick_add: section.settings.show_quick_add %}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Just Landed" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 24, "step": 1, "default": 8 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "checkbox", "id": "wide", "label": "Use wide grid", "default": false },
    { "type": "checkbox", "id": "tight_top", "label": "Tighten top spacing", "default": false },
    { "type": "checkbox", "id": "show_quick_add", "label": "Show quick add", "default": true }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
