<div class="wrap">
  <div class="page-hero">
    <p class="kicker center">My Account</p>
    <h1>Saved addresses</h1>
  </div>

  <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;padding:0 0 4vh">
    <a class="btn btn-sm" href="{{ routes.account_url }}"><span>Back to account</span></a>
    <a class="btn btn-sm" href="{{ routes.account_logout_url }}"><span>Log out</span></a>
  </div>

  <div class="acct-layout">
    <div>
      {%- for address in customer.addresses -%}
        <div class="addr-card">
          {%- if address == customer.default_address -%}
            <p class="kicker" style="margin-bottom:12px">Default</p>
          {%- endif -%}
          {{ address | format_address }}
          <div class="acts">
            <button type="button" data-address-edit="{{ address.id }}">Edit</button>
            <a href="#" data-address-delete="{{ address.id }}">Delete</a>
          </div>

          {%- assign addr_form_id = 'AddressForm-' | append: address.id -%}
          {%- form 'customer_address', address, id: addr_form_id, class: 'addr-edit-form' -%}
            <div class="field" style="margin-top:16px"><label>First name</label><input type="text" name="address[first_name]" value="{{ address.first_name }}"></div>
            <div class="field"><label>Last name</label><input type="text" name="address[last_name]" value="{{ address.last_name }}"></div>
            <div class="field"><label>Company</label><input type="text" name="address[company]" value="{{ address.company }}"></div>
            <div class="field"><label>Address</label><input type="text" name="address[address1]" value="{{ address.address1 }}"></div>
            <div class="field"><label>Apartment, suite</label><input type="text" name="address[address2]" value="{{ address.address2 }}"></div>
            <div class="field"><label>City</label><input type="text" name="address[city]" value="{{ address.city }}"></div>
            <div class="field"><label>State</label><input type="text" name="address[province]" value="{{ address.province }}"></div>
            <div class="field"><label>PIN code</label><input type="text" name="address[zip]" value="{{ address.zip }}"></div>
            <div class="field"><label>Phone</label><input type="tel" name="address[phone]" value="{{ address.phone }}"></div>
            <button class="btn btn-sm btn-solid" type="submit"><span>Save address</span></button>
          {%- endform -%}

          {%- form 'customer_address', address, data-address-delete-form: address.id -%}
            <input type="hidden" name="_method" value="delete">
          {%- endform -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="cust-card">
      <h3>Add a new address</h3>
      {%- form 'customer_address', customer.new_address, id: 'AddressFormNew' -%}
        {%- if form.errors -%}<div class="shopify-form-msg error">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field"><label>First name</label><input type="text" name="address[first_name]" value="{{ form.first_name }}"></div>
        <div class="field"><label>Last name</label><input type="text" name="address[last_name]" value="{{ form.last_name }}"></div>
        <div class="field"><label>Company</label><input type="text" name="address[company]" value="{{ form.company }}"></div>
        <div class="field"><label>Address</label><input type="text" name="address[address1]" value="{{ form.address1 }}"></div>
        <div class="field"><label>Apartment, suite</label><input type="text" name="address[address2]" value="{{ form.address2 }}"></div>
        <div class="field"><label>City</label><input type="text" name="address[city]" value="{{ form.city }}"></div>
        <div class="field"><label>State</label><input type="text" name="address[province]" value="{{ form.province }}"></div>
        <div class="field"><label>PIN code</label><input type="text" name="address[zip]" value="{{ form.zip }}"></div>
        <div class="field"><label>Phone</label><input type="tel" name="address[phone]" value="{{ form.phone }}"></div>
        <button class="btn btn-solid" type="submit"><span>Add address</span></button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Addresses",
  "tag": "section",
  "settings": []
}
{% endschema %}
