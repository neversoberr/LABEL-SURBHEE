<div class="wrap">
  <div class="page-hero">
    <p class="kicker center">New password</p>
    <h1>Reset password</h1>
  </div>
  <div class="acct-layout">
    {%- form 'reset_customer_password', id: 'ResetPasswordForm' -%}
      <div class="cust-card">
        <h3>Choose a new password</h3>
        {%- if form.errors -%}<div class="shopify-form-msg error">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field">
          <label for="ResetPassword">Password</label>
          <input id="ResetPassword" type="password" name="customer[password]" required>
        </div>
        <div class="field">
          <label for="ResetPasswordConfirm">Confirm password</label>
          <input id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" required>
        </div>
        <button class="btn btn-solid" type="submit"><span>Update password</span></button>
      </div>
    {%- endform -%}
    <div class="cust-card">
      <h3>Need help?</h3>
      <p class="muted" style="font-size:14px">If the link has expired, request a fresh one — or WhatsApp us and we’ll sort it out in minutes.</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Reset password",
  "tag": "section",
  "settings": []
}
{% endschema %}
