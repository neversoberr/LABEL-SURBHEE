{%- comment -%} "Shop by mood" category tiles. {%- endcomment -%}
<section class="sec wrap">
  <div class="sec-head rv">
    <div>
      {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2 class="h-lg" style="margin-top:12px">{{ section.settings.heading }}</h2>
    </div>
    {%- if section.settings.link_label != blank -%}
      <a class="btn btn-sm" href="{{ section.settings.link_url }}"><span>{{ section.settings.link_label }}</span></a>
    {%- endif -%}
  </div>
  <div class="cattiles">
    {%- for block in section.blocks -%}
      <a class="ctile rv" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ block.settings.title | escape }}" loading="lazy">
        {%- elsif block.settings.fallback_asset != blank -%}
          <img src="{{ block.settings.fallback_asset | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
        {%- endif -%}
        <div class="in">
          <div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
          <span class="go">↗</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Category tiles",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The House" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by mood" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All collections" },
    { "type": "url", "id": "link_url", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_asset", "label": "Theme asset filename", "info": "Used if no image is picked, e.g. lehenga1.jpg" },
        { "type": "text", "id": "title", "label": "Title", "default": "Lehengas" },
        { "type": "text", "id": "text", "label": "Caption", "default": "Bridal to party" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "tile", "settings": { "title": "Clothing", "text": "Dresses to dupattas", "fallback_asset": "dress1.jpg" } },
        { "type": "tile", "settings": { "title": "Lehengas", "text": "Bridal to party", "fallback_asset": "lehenga1.jpg" } },
        { "type": "tile", "settings": { "title": "Jewellery", "text": "Kundan & chooda", "fallback_asset": "jewel1.jpg" } },
        { "type": "tile", "settings": { "title": "Festive Edit", "text": "The glow edit", "fallback_asset": "saree1.jpg" } }
      ]
    }
  ]
}
{% endschema %}
