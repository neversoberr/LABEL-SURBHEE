{%- comment -%} Editorial collections grid (the eight edits). {%- endcomment -%}
<section class="sec wrap">
  <div class="sec-head rv">
    <div>
      {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2 class="h-lg" style="margin-top:12px">{{ section.settings.heading }}</h2>
    </div>
    {%- if section.settings.link_label != blank -%}
      <a class="btn btn-sm" href="{{ routes.all_collections_url }}"><span>{{ section.settings.link_label }}</span></a>
    {%- endif -%}
  </div>

  <div class="collgrid">
    {%- for block in section.blocks -%}
      {%- assign c = block.settings.collection -%}
      {%- if c == blank and block.settings.title == blank -%}{%- continue -%}{%- endif -%}
      <a class="citem {% if block.settings.tall %}tall{% endif %} {% if block.settings.wide %}wide{% endif %} rv"
         href="{{ c.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.title | default: c.title | escape }}" loading="lazy">
        {%- elsif c.image -%}
          <img src="{{ c.image | image_url: width: 900 }}" alt="{{ c.title | escape }}" loading="lazy">
        {%- elsif block.settings.fallback_asset != blank -%}
          <img src="{{ block.settings.fallback_asset | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
        {%- endif -%}
        <span class="arr">↗</span>
        <div class="in">
          <span class="k">Collection</span>
          <h3>{{ block.settings.title | default: c.title }}</h3>
          <p>{{ block.settings.blurb | default: c.description | strip_html | truncate: 90 }}</p>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections grid",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Editorial" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" },
    { "type": "text", "id": "link_label", "label": "Link label" }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "textarea", "id": "blurb", "label": "Blurb override" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "fallback_asset", "label": "Theme asset filename", "info": "e.g. lehenga2.jpg" },
        { "type": "checkbox", "id": "tall", "label": "Tall tile (2 rows)", "default": false },
        { "type": "checkbox", "id": "wide", "label": "Wide tile (2 columns)", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections grid",
      "blocks": [
        { "type": "collection_item", "settings": { "title": "New Collection", "blurb": "This season’s first looks — maroon silk, gold thread, fresh air.", "fallback_asset": "lehenga2.jpg", "tall": true } },
        { "type": "collection_item", "settings": { "title": "Rozana", "blurb": "Polished pieces for days that don’t ask for ceremony.", "fallback_asset": "top1.jpg" } },
        { "type": "collection_item", "settings": { "title": "Festive Edit", "blurb": "Diwali light, wedding light — everything that catches the glow.", "fallback_asset": "saree1.jpg" } },
        { "type": "collection_item", "settings": { "title": "Wedding Edit", "blurb": "Bridal lehengas and heirloom jewellery, made for the moment you wait a lifetime for.", "fallback_asset": "lehenga1.jpg", "wide": true } }
      ]
    }
  ]
}
{% endschema %}
