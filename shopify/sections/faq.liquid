<div class="wrap">
  <div class="page-hero">
    <p class="kicker center">{{ section.settings.kicker }}</p>
    <h1>{{ page.title | default: section.settings.heading }}</h1>
  </div>
  <div class="prose" style="padding:6vh 0 9vh;max-width:82ch;margin:0 auto">
    {%- for block in section.blocks -%}
      <div class="faq-item" {{ block.shopify_attributes }}>
        <button type="button" data-action="faq">{{ block.settings.question }}<span class="pm">+</span></button>
        <div class="body"><p>{{ block.settings.answer }}</p></div>
      </div>
    {%- endfor -%}
    <div style="text-align:center;margin-top:5vh">
      <a class="btn" href="https://wa.me/{{ settings.brand_whatsapp | remove: '+' | remove: ' ' }}?text={{ 'Hi Label Surbhee! I have a question.' | url_encode }}" target="_blank" rel="noopener"><span>Still stuck? Chat on WhatsApp</span></a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Questions, answered" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQ" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How do I choose my size?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Every clothing and lehenga page has a size guide with bust, waist and hip measurements." }
      ]
    }
  ],
  "presets": [{ "name": "FAQ" }]
}
{% endschema %}
