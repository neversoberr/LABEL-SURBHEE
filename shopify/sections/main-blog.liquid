<div class="wrap">
  <div class="page-hero">
    <p class="kicker center">Journal</p>
    <h1>{{ blog.title }}</h1>
  </div>
  <div class="blog-grid">
    {%- for article in blog.articles -%}
      <a class="post-card rv" href="{{ article.url }}">
        {%- if article.image -%}
          <div class="pcard-img"><img src="{{ article.image | image_url: width: 700 }}" alt="{{ article.title | escape }}" loading="lazy"></div>
        {%- endif -%}
        <p class="meta">{{ article.published_at | date: '%d %B %Y' }}</p>
        <h3>{{ article.title }}</h3>
        <p class="muted" style="font-size:13.5px">{{ article.excerpt_or_content | strip_html | truncate: 110 }}</p>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "settings": []
}
{% endschema %}
