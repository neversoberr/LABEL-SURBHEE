{%- comment -%}
  Product page — gallery, variant pickers, add-to-bag, PIN estimator,
  accordions, reviews and related pieces.
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign product_form_id = 'product-form-' | append: section.id -%}

{%- assign ls_rating = product.metafields.custom.rating.value -%}
{%- if ls_rating == blank -%}{%- assign ls_rating = product.metafields.reviews.rating.value -%}{%- endif -%}
{%- if ls_rating == blank -%}{%- assign ls_rating = product.metafields.reviews.rating -%}{%- endif -%}
{%- assign ls_rating = ls_rating | plus: 0 -%}
{%- assign ls_rcount = product.metafields.custom.review_count.value | default: product.metafields.reviews.rating_count -%}
{%- assign ls_fabric = product.metafields.custom.fabric.value | default: product.metafields.custom.fabric -%}

<div class="wrap" data-product-root data-product-handle="{{ product.handle }}">
  {% render 'breadcrumbs',
     crumb_1_title: 'Shop',
     crumb_1_url: routes.all_products_collection_url,
     crumb_2_title: product.type,
     crumb_3_title: product.title %}

  <div class="prod">
    <!-- gallery -->
    <div class="prod-gallery rv in">
      <div class="main">
        <img
          id="gal-main"
          src="{{ product.featured_image | image_url: width: 1200 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          width="1200" height="1500">
      </div>
      {%- if product.media.size > 1 -%}
        <div class="prod-thumbs">
          {%- for media in product.media -%}
            <button
              type="button"
              class="{% if forloop.first %}on{% endif %}"
              data-thumb-src="{{ media.preview_image | image_url: width: 1200 }}"
              data-thumb-alt="{{ media.alt | default: product.title | escape }}"
              aria-label="View image {{ forloop.index }}">
              <img src="{{ media.preview_image | image_url: width: 400 }}" alt="{{ media.alt | default: product.title | escape }}" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <!-- info -->
    <div class="prod-info">
      {%- if product.type != blank -%}<p class="kicker">{{ product.type }}</p>{%- endif -%}
      <h1>{{ product.title }}</h1>

      {%- if ls_rating > 0 -%}
        <div class="rate">
          {% render 'stars', rating: ls_rating %}
          <span>{{ ls_rating | round: 1 }}{% if ls_rcount != blank %} · {{ ls_rcount }} reviews{% endif %}</span>
        </div>
      {%- endif -%}

      <div class="prod-price" data-price-root>
        <span class="now" data-price>{{ current_variant.price | money_without_trailing_zeros }}</span>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <s data-compare-price>{{ current_variant.compare_at_price | money_without_trailing_zeros }}</s>
          <span class="off" data-price-off>{{ current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round }}% off</span>
        {%- endif -%}
        <span class="muted" style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;margin-left:auto">Inclusive of taxes</span>
      </div>

      {%- form 'product', product, id: product_form_id, class: 'product-form', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>
        <input type="hidden" name="quantity" value="1" data-quantity-input>

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            {%- assign opt_index = forloop.index0 -%}
            {%- assign is_colour = false -%}
            {%- assign opt_name = option.name | downcase -%}
            {%- if opt_name == 'colour' or opt_name == 'color' -%}{%- assign is_colour = true -%}{%- endif -%}

            <div class="opt-label">
              <span>{{ option.name }}</span>
              {%- if option.name == 'Size' -%}
                <a href="#" data-size-guide>Size guide</a>
              {%- else -%}
                <span class="muted" data-option-label="{{ opt_index }}" style="letter-spacing:.06em;text-transform:none;font-size:12px">{{ option.selected_value }}</span>
              {%- endif -%}
            </div>

            {%- if is_colour -%}
              <div class="swatches" data-option-group="{{ opt_index }}">
                {%- for value in option.values -%}
                  {%- assign hex = '#efe6d4' -%}
                  {%- case value -%}
                    {%- when 'Maroon' -%}{%- assign hex = '#4a1220' -%}
                    {%- when 'Gold' -%}{%- assign hex = '#c9a24b' -%}
                    {%- when 'Antique Gold' -%}{%- assign hex = '#c9a24b' -%}
                    {%- when 'Ivory' -%}{%- assign hex = '#efe6d4' -%}
                  {%- endcase -%}
                  <button
                    type="button"
                    class="sw{% if option.selected_value == value %} on{% endif %}"
                    style="background:{{ hex }}"
                    data-option-value="{{ value | escape }}"
                    title="{{ value | escape }}"
                    aria-label="{{ value | escape }}"></button>
                {%- endfor -%}
              </div>
            {%- else -%}
              <div class="sizes" data-option-group="{{ opt_index }}">
                {%- for value in option.values -%}
                  <button
                    type="button"
                    class="szb{% if option.selected_value == value %} on{% endif %}"
                    data-option-value="{{ value | escape }}">{{ value }}</button>
                {%- endfor -%}
              </div>
            {%- endif -%}

            <select name="options[{{ option.name | escape }}]" class="visually-hidden" data-option-select="{{ opt_index }}">
              {%- for value in option.values -%}
                <option value="{{ value | escape }}" {% if option.selected_value == value %}selected="selected"{% endif %}>{{ value }}</option>
              {%- endfor -%}
            </select>
          {%- endfor -%}
        {%- endunless -%}

        <div class="buyrow">
          <div class="qty">
            <button type="button" data-action="pdec" aria-label="Decrease quantity">−</button>
            <span data-qty-display>1</span>
            <button type="button" data-action="pinc" aria-label="Increase quantity">+</button>
          </div>
          <button class="btn btn-solid" type="submit" name="add" data-add-button {% unless current_variant.available %}disabled{% endunless %}>
            <span data-add-label>{% if current_variant.available %}Add to bag{% else %}Sold Out{% endif %}</span>
          </button>
        </div>
      {%- endform -%}

      <div class="wishline">
        <button type="button" data-wish="{{ product.handle }}">
          {% render 'icon', icon: 'heart' %} <span data-wish-label>Save to wishlist</span>
        </button>
        <span style="opacity:.4">·</span>
        <a href="https://wa.me/{{ settings.brand_whatsapp | remove: '+' | remove: ' ' }}?text={{ 'Hi Label Surbhee! I need help with sizing.' | url_encode }}" target="_blank" rel="noopener" style="display:inline-flex;gap:8px;align-items:center">
          {% render 'icon', icon: 'wa' %} Need help? Chat with us
        </a>
      </div>

      <!-- PIN delivery estimator -->
      <div class="deliv">
        <div class="row">
          <input id="pin" maxlength="6" inputmode="numeric" placeholder="Enter your PIN code" aria-label="PIN code" data-pin-input>
          <button type="button" data-action="pin">Check delivery</button>
        </div>
        <div class="res" data-pin-result></div>
      </div>

      <!-- accordions -->
      {%- if product.description != blank -%}
        <div class="acc">
          <button type="button" data-action="acc"><span>The details</span><span class="pm">+</span></button>
          <div class="body"><div class="body-in prose">{{ product.description }}</div></div>
        </div>
      {%- endif -%}

      {%- if ls_fabric != blank -%}
        <div class="acc open">
          <button type="button" data-action="acc"><span>Fabric &amp; care</span><span class="pm">+</span></button>
          <div class="body">
            <div class="body-in">
              <b>{{ ls_fabric }}.</b>
              {%- if product.type contains 'Jewellery' or product.type contains 'Earrings' or product.type contains 'Necklaces' or product.type contains 'Rings' or product.type contains 'Bangles' -%}
                Keep away from perfume and water; store in the pouch provided. Gently wipe with a soft dry cloth.
              {%- else -%}
                Dry clean only. Store hung with a padded hanger; do not iron directly on embroidery.
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'accordion' -%}
          <div class="acc" {{ block.shopify_attributes }}>
            <button type="button" data-action="acc"><span>{{ block.settings.heading }}</span><span class="pm">+</span></button>
            <div class="body"><div class="body-in">{{ block.settings.content }}</div></div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <!-- reviews -->
  {%- assign review_blocks = section.blocks | where: 'type', 'review' -%}
  {%- if review_blocks.size > 0 or ls_rating > 0 -%}
    <div class="rev">
      <div class="sec-head rv in">
        <div>
          <p class="kicker">Reviews</p>
          <h2 class="h-md" style="margin-top:10px">What they’re saying</h2>
        </div>
        <div class="rev-sum">
          <span class="n">{{ ls_rating | round: 1 }}</span>
          <div>
            {% render 'stars', rating: ls_rating %}
            <p class="muted" style="font-size:12px;margin-top:6px">{{ ls_rcount | default: review_blocks.size }} verified reviews</p>
          </div>
        </div>
      </div>

      {%- if review_blocks.size > 0 -%}
        <div class="rev-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'review' -%}
              <div class="rev-card rv in" {{ block.shopify_attributes }}>
                <div class="top">
                  <div class="who">
                    <b style="font-weight:400">{{ block.settings.name }}</b>
                    <small>{{ block.settings.city }}{% if block.settings.date != blank %} · {{ block.settings.date }}{% endif %}</small>
                  </div>
                  {%- if block.settings.verified -%}<span class="verif">✓ Verified</span>{%- endif -%}
                </div>
                {% render 'stars', rating: block.settings.rating %}
                <p style="margin-top:10px">“{{ block.settings.text }}”</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="rev-form">
        <h4>Write a review</h4>
        <p class="muted" style="font-size:13px">Tell us how it felt — or send us a voice note, we read everything.</p>
        <a class="btn btn-sm btn-solid" style="margin-top:16px"
           href="https://wa.me/{{ settings.brand_whatsapp | remove: '+' | remove: ' ' }}?text={{ 'Hi Label Surbhee! I’d like to leave a review for ' | append: product.title | url_encode }}"
           target="_blank" rel="noopener"><span>Send your review</span></a>
      </div>
    </div>
  {%- endif -%}

  <!-- related -->
  {%- assign related_source = product.collections.first -%}
  {%- if related_source != blank and related_source.products.size > 1 -%}
    <div class="related">
      <div class="sec-head">
        <div>
          <p class="kicker">Keep looking</p>
          <h2 class="h-md" style="margin-top:10px">You may also love</h2>
        </div>
        <a class="btn btn-sm" href="{{ related_source.url }}"><span>View all</span></a>
      </div>
      <div class="pgrid">
        {%- assign shown = 0 -%}
        {%- for prod in related_source.products -%}
          {%- if prod.id == product.id -%}{%- continue -%}{%- endif -%}
          {%- if shown >= section.settings.related_count -%}{%- break -%}{%- endif -%}
          {% render 'product-card', product: prod, index: forloop.index0 %}
          {%- assign shown = shown | plus: 1 -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

<script type="application/json" data-product-variants>
[
  {%- for v in product.variants -%}
    {"id":{{ v.id }},"available":{{ v.available }},"price":{{ v.price }},"compare_at_price":{{ v.compare_at_price | default: 0 }},"options":[{{ v.option1 | json }}{% if product.options.size > 1 %},{{ v.option2 | json }}{% endif %}{% if product.options.size > 2 %},{{ v.option3 | json }}{% endif %}]}{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
]
</script>

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "related_count", "label": "Related products", "min": 0, "max": 8, "step": 1, "default": 4 }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Free shipping across India on orders above ₹1,999. Tracked by email and WhatsApp at every step.</p>" }
      ]
    },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Ananya M." },
        { "type": "text", "id": "city", "label": "City", "default": "Mumbai" },
        { "type": "text", "id": "date", "label": "Date", "default": "2 weeks ago" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "checkbox", "id": "verified", "label": "Verified badge", "default": true },
        { "type": "textarea", "id": "text", "label": "Review text", "default": "The zardozi is even more beautiful in person." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product information",
      "blocks": [
        { "type": "accordion", "settings": { "heading": "Shipping", "content": "<p>Free shipping across India on orders above ₹1,999. Metro delivery in 2–4 days, rest of India in 3–7 days.</p>" } },
        { "type": "accordion", "settings": { "heading": "Returns & exchange", "content": "<p>7-day returns and free exchange on unworn items with tags.</p>" } }
      ]
    }
  ]
}
{% endschema %}
