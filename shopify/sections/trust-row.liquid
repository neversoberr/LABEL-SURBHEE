{%- comment -%} Four-up trust / service bar. {%- endcomment -%}
<section class="wrap" style="padding-bottom:8vh">
  <div class="trust rv">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        {% render 'icon', icon: block.settings.icon %}
        <div><h5>{{ block.settings.heading }}</h5><p>{{ block.settings.text }}</p></div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Trust bar",
  "tag": "section",
  "max_blocks": 5,
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "swap", "label": "Swap" },
            { "value": "shield", "label": "Shield" },
            { "value": "cash", "label": "Cash" },
            { "value": "lock", "label": "Lock" },
            { "value": "star", "label": "Star" },
            { "value": "heart", "label": "Heart" },
            { "value": "phone", "label": "Phone" },
            { "value": "mail", "label": "Mail" },
            { "value": "clock", "label": "Clock" },
            { "value": "pin", "label": "Pin" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Free Shipping" },
        { "type": "text", "id": "text", "label": "Text", "default": "On all orders above ₹1,999" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "heading": "Free Shipping", "text": "On all orders above ₹1,999" } },
        { "type": "item", "settings": { "icon": "swap", "heading": "7-Day Returns", "text": "Easy exchange across India" } },
        { "type": "item", "settings": { "icon": "shield", "heading": "Secure Checkout", "text": "256-bit SSL protected" } },
        { "type": "item", "settings": { "icon": "cash", "heading": "COD Available", "text": "Cash on delivery across India" } }
      ]
    }
  ]
}
{% endschema %}
